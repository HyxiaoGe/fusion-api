# 治理任务专用配置；master/provider keys 直接来自现有 litellm-proxy/.env。
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_CANDIDATE_KEY=
# Fusion 当前使用的 LiteLLM 虚拟密钥，仅供准入后更新 allowlist 并回读目录。
LITELLM_VIRTUAL_KEY=
# 模型管理 Worker 只连接宿主机内网 API；token 与 fusion-api 的同名配置一致。
FUSION_MODEL_MANAGEMENT_BASE_URL=http://127.0.0.1:8002
LITELLM_MODEL_ADMISSION_WORKER_TOKEN=
# 与 fusion-api 使用同一快照有效期，避免 API 与 Worker 判定分叉。
LITELLM_GOVERNANCE_MAX_AGE_SECONDS=86400
